{
  "build": {
    "beforeBuildCommand": "npm run build && cargo build --release -p th-service"
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../target/release/th-service.exe": "th-service.exe"
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Ukrainian",
          "Russian",
          "Spanish",
          "French",
          "German",
          "PortugueseBR",
          "Italian",
          "Polish",
          "SimpChinese",
          "Japanese"
        ],
        "customLanguageFiles": {
          "Polish": "windows/Polish.nsh"
        }
      }
    }
  }
}
