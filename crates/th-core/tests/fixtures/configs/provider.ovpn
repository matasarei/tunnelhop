# Typical provider config: every directive here must be accepted.
client
dev tun
proto udp
remote kyiv-1.vpn.example.net 1194
remote 198.51.100.9 443 tcp
remote-random
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name server.example.net name
data-ciphers AES-256-GCM:CHACHA20-POLY1305
auth SHA256
tls-version-min 1.2
key-direction 1
auth-user-pass auth.txt
auth-nocache
setenv CLIENT_CERT 0
reneg-sec 0
setenv opt block-outside-dns
block-outside-dns
pull-filter ignore "dhcp-option DNS6"
redirect-gateway def1 ipv6
explicit-exit-notify 2
verb 3
<ca>
-----BEGIN CERTIFICATE-----
MIIBcert
-----END CERTIFICATE-----
</ca>
<tls-crypt>
-----BEGIN OpenVPN Static key V1-----
abcdef
-----END OpenVPN Static key V1-----
</tls-crypt>
