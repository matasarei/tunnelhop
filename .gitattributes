# Shell scripts run under sh, which breaks on CRLF line endings.
.githooks/* text eol=lf
# Generated by scripts/third-party-notices.mjs: kept out of GitHub's language statistics (the
# 1.5 MB of Rust standard-library notices would otherwise show the repository as mostly HTML)
# and collapsed in diffs.
THIRD-PARTY-NOTICES.txt linguist-generated=true
THIRD-PARTY-NOTICES-RUST.html linguist-generated=true
