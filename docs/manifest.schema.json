{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matasarei/tunnelhop/docs/manifest.schema.json",
  "title": "TunnelHop bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_name", "profiles"],
  "properties": {
    "schema_version": { "const": "1" },
    "bundle_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/protocol" }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "strategy": { "enum": ["random"] },
        "interval_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "on_disconnect": { "enum": ["reconnect_same", "reconnect_random", "stay_down"] },
        "reconnect_grace_seconds": { "type": "integer", "minimum": 5, "maximum": 300 }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "protocol", "file"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "protocol": { "$ref": "#/$defs/protocol" },
          "file": { "type": "string", "pattern": "^(wireguard|openvpn)/[^/\\\\]+(/[^/\\\\]+)*$" }
        }
      }
    }
  },
  "$defs": {
    "protocol": { "enum": ["wireguard", "openvpn"] }
  }
}
